{
  "name": "@flux/core",
  "version": "1.0.0",
  "description": "Thin server-driven frontend layer on HTMX 4. Shorthand attributes, lifecycle, presets — without reimplementing htmx.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/flux.d.ts",
      "import": "./dist/flux.js",
      "default": "./dist/flux.iife.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/flux.iife.js",
  "module": "./dist/flux.js",
  "types": "./dist/flux.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "flux-ui": "./dist/cli/index.js"
  },
  "peerDependencies": {
    "htmx.org": "4.0.0-beta6"
  },
  "peerDependenciesMeta": {
    "htmx.org": {
      "optional": false
    }
  },
  "dependencies": {
    "alpinejs": "3.15.12"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "22.12.0",
    "eslint": "9.15.0",
    "htmx.org": "4.0.0-beta6",
    "jsdom": "25.0.1",
    "prettier": "3.4.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.15.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:modular && npm run build:full && npm run build:css && tsc -p tsconfig.build.json",
    "build:modular": "vite build --mode es && vite build --mode iife",
    "build:full": "vite build --mode full-es && vite build --mode full-iife",
    "build:css": "node scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:browser": "playwright test --config=test/e2e/playwright.config.ts",
    "test:watch": "vitest",
    "size": "node scripts/size.mjs",
    "example": "node examples/vanilla/server.mjs"
  }
}
