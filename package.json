{
  "name": "flux-htmx",
  "version": "1.3.1",
  "description": "Thin server-driven frontend layer on HTMX 4. Shorthand fx-* attributes, lifecycle, presets, prefetch, and toast — without reimplementing htmx.",
  "keywords": [
    "htmx",
    "htmx4",
    "hypermedia",
    "server-driven",
    "flux",
    "hx",
    "fx",
    "frontend",
    "toast",
    "prefetch"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/flux.d.ts",
      "import": "./dist/flux.js",
      "default": "./dist/flux.iife.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/flux.iife.js",
  "module": "./dist/flux.js",
  "types": "./dist/flux.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "htmx.org": "4.0.0-beta6"
  },
  "peerDependenciesMeta": {
    "htmx.org": {
      "optional": false
    }
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "22.12.0",
    "eslint": "10.8.0",
    "htmx.org": "4.0.0-beta6",
    "jsdom": "25.0.1",
    "prettier": "3.4.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:modular && npm run build:full && npm run build:css && tsc -p tsconfig.build.json",
    "build:modular": "vite build --mode es && vite build --mode iife",
    "build:full": "vite build --mode full-es && vite build --mode full-iife",
    "build:css": "node scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:log": "vitest run --reporter=verbose",
    "test:unit": "vitest run",
    "test:browser": "playwright test --config=test/e2e/playwright.config.ts",
    "test:watch": "vitest",
    "size": "node scripts/size.mjs",
    "example": "node examples/vanilla/server.mjs"
  }
}
